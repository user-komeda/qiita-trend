{
  "name": "qiita-trend-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "infisicalLauncher --path=/qiitaTrend/next/local -- yarn next dev",
    "build": "yarn next build",
    "start": "yarn next start",
    "lint": "eslint ./",
    "format": "prettier --write \"src/**/*.(ts|tsx)\"",
    "check": "yarn concurrently 'yarn typecheck' 'yarn lint' 'yarn format'  'yarn test' 'yarn test:e2e:ci'",
    "test": "vitest run --coverage --pool=forks",
    "test:watch": "vitest --watch",
    "test:cov": "vitest --coverage",
    "test:e2e:prepare": "infisicalLauncher --path=/qiitaTrend/next/local -- yarn playwright codegen --save-storage=playwright/.auth/qiita.json https://qiita.com",
    "test:e2e": " yarn playwright test",
    "test:e2e:ci": "yarn playwright test --grep-invert @local-only",
    "test:e2e:ui": "yarn playwright test --ui",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@next/env": "^16.4.2",
    "@qiita-trend/schema": "workspace:*",
    "jsdom": "^30.1.3",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "redis": "^6.3.0",
    "remark-gfm": "^4.0.1",
    "valibot": "^1.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fetch-mock/vitest": "0.2.18",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "1.64.1",
    "@qiita-trend/eslint": "workspace:*",
    "@qiita-trend/tsconfig": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-no-relative-import-paths": "1.7.3",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-testing-library": "7.16.2",
    "prettier": "3.9.10",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "packageManager": "yarn@4.16.0"
}
