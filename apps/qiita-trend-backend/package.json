{
  "name": "qiita-trend-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "yarn nest build -c nest-cli-prod.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "infisicalLauncher --path=/qiitaTrend/nest/local -- yarn  nest start -b swc --debug --watch",
    "start": "node dist/main",
    "lint": "eslint ./",
    "lint:fix": "eslint ./ --fix",
    "typecheck": "tsc --noEmit",
    "check": "yarn concurrently 'yarn lint' 'yarn format' 'yarn typecheck' 'yarn test'",
    "test": "infisicalLauncher --path=/qiitaTrend/nest/local -- yarn vitest run --coverage --pool=forks",
    "test:watch": "infisicalLauncher --path=/qiitaTrend/nest/local -- yarn vitest --watch",
    "test:cov": "infisicalLauncher --path=/qiitaTrend/nest/local -- yarn vitest --coverage"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@qiita-trend/schema": "workspace:*",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "1.4.7",
    "redis": "6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@darraghor/eslint-plugin-nestjs-typed": "7.5.8",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.2.0",
    "@qiita-trend/eslint": "workspace:*",
    "@qiita-trend/tsconfig": "workspace:*",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.20",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  },
  "packageManager": "yarn@4.16.0"
}
